diff --git a/src/boltz/data/crop_embeddings.py b/src/boltz/data/crop_embeddings.py
new file mode 100644
index 0000000..0c5e31d
--- /dev/null
+++ b/src/boltz/data/crop_embeddings.py
@@ -0,0 +1,233 @@
+"""Cache ligand-incident pair representations and affinity-head inputs."""
+
+from __future__ import annotations
+
+from pathlib import Path
+from typing import Optional, Union
+
+import numpy as np
+import torch
+
+CROPPED_FORMAT = "cropped_v1"
+AFFINITY_CROPPED_FORMAT = "affinity_cropped_v1"
+
+
+def _to_numpy(x) -> np.ndarray:
+    if isinstance(x, torch.Tensor):
+        return x.detach().cpu().numpy()
+    return np.asarray(x)
+
+
+def save_cropped_z(
+    path: Union[str, Path],
+    z: torch.Tensor,
+    keep_token_mask: torch.Tensor,
+    token_pad_mask: Optional[torch.Tensor] = None,
+    original_token_indices: Optional[torch.Tensor] = None,
+) -> None:
+    """Save pair strips in the original token order.
+
+    keep_token_mask must include every affinity binder token."""
+    z = _to_numpy(z)
+    if z.ndim == 4:
+        if z.shape[0] != 1:
+            msg = f"save_cropped_z expects batch size 1, got z.shape={z.shape}"
+            raise ValueError(msg)
+        z = z[0]
+    elif z.ndim != 3:
+        msg = f"Unexpected z shape {z.shape}; expected [B,L,L,C] or [L,L,C]."
+        raise ValueError(msg)
+
+    lig_mask = _to_numpy(keep_token_mask).astype(bool)
+    if lig_mask.ndim == 2:
+        lig_mask = lig_mask[0]
+    if token_pad_mask is not None:
+        pad = _to_numpy(token_pad_mask).astype(bool)
+        if pad.ndim == 2:
+            pad = pad[0]
+        lig_mask = lig_mask & pad
+
+    L = z.shape[0]
+    lig_idx = np.nonzero(lig_mask[:L])[0].astype(np.int64)
+    if lig_idx.size == 0:
+        msg = "No keep tokens found (empty ligand/keep mask); cannot crop z."
+        raise ValueError(msg)
+
+    z_rows = np.ascontiguousarray(z[lig_idx, :, :], dtype=np.float32)
+    z_cols = np.ascontiguousarray(z[:, lig_idx, :], dtype=np.float32)
+
+    arrays = {
+        "format": np.array(CROPPED_FORMAT),
+        "z_rows": z_rows,
+        "z_cols": z_cols,
+        "lig_idx": lig_idx,
+        "L": np.array(L, dtype=np.int64),
+    }
+    if token_pad_mask is not None:
+        pad_out = _to_numpy(token_pad_mask).astype(bool)
+        if pad_out.ndim == 2:
+            pad_out = pad_out[0]
+        arrays["token_pad_mask"] = pad_out[:L]
+    if original_token_indices is not None:
+        oti = _to_numpy(original_token_indices).astype(np.int64)
+        if oti.ndim == 2:
+            oti = oti[0]
+        arrays["original_token_indices"] = oti[:L]
+
+    Path(path).parent.mkdir(parents=True, exist_ok=True)
+    np.savez(path, **arrays)
+
+
+def is_cropped(npz) -> bool:
+    """True if the loaded npz uses the cropped strip schema."""
+    files = getattr(npz, "files", None)
+    if files is None:
+        return False
+    if "z_rows" in files and "z_cols" in files and "lig_idx" in files:
+        return True
+    return False
+
+
+def reconstruct_z_from_cropped(npz) -> np.ndarray:
+    """Rebuild the full zero-filled ``z`` [L, L, C] from cropped strips."""
+    z_rows = npz["z_rows"]  # [n_lig, L, C]
+    z_cols = npz["z_cols"]  # [L, n_lig, C]
+    lig_idx = npz["lig_idx"].astype(np.int64)
+    L = int(npz["L"])
+    C = z_rows.shape[-1]
+    if z_rows.shape != (lig_idx.size, L, C) or z_cols.shape != (L, lig_idx.size, C):
+        msg = (
+            "Cropped z strips inconsistent: "
+            f"z_rows={z_rows.shape}, z_cols={z_cols.shape}, "
+            f"lig_idx={lig_idx.size}, L={L}, C={C}"
+        )
+        raise ValueError(msg)
+    full = np.zeros((L, L, C), dtype=np.float32)
+    full[lig_idx, :, :] = z_rows
+    full[:, lig_idx, :] = z_cols  # lig-lig overlap is identical, safe to overwrite
+    return full
+
+
+def load_precomputed_z(path: Union[str, Path]) -> torch.Tensor:
+    """Load cropped or dense cached pairs as [1, L, L, C] float32."""
+    path = Path(path)
+    if not path.exists():
+        msg = f"Embedding cache not found: {path}"
+        raise FileNotFoundError(msg)
+    with np.load(path, allow_pickle=True) as npz:
+        if is_cropped(npz):
+            full = reconstruct_z_from_cropped(npz)  # [L, L, C]
+        elif "z" in getattr(npz, "files", []):
+            z = npz["z"]
+            full = z[0] if z.ndim == 4 else z  # [L, L, C]
+            full = np.ascontiguousarray(full, dtype=np.float32)
+        else:
+            msg = (
+                f"Embedding cache {path} has neither cropped strips "
+                f"(z_rows/z_cols/lig_idx) nor a full 'z' array."
+            )
+            raise KeyError(msg)
+    return torch.from_numpy(full).unsqueeze(0)  # [1, L, L, C]
+
+
+def save_affinity_cropped_inputs(
+    path: Union[str, Path],
+    *,
+    z: torch.Tensor,
+    s_inputs: torch.Tensor,
+    coords: torch.Tensor,
+    token_to_rep_atom: torch.Tensor,
+    token_pad_mask: torch.Tensor,
+    mol_type: torch.Tensor,
+    affinity_token_mask: torch.Tensor,
+    original_token_indices: Optional[torch.Tensor] = None,
+    affinity_mw: Optional[torch.Tensor] = None,
+) -> None:
+    """Store affinity inputs, omitting masked receptor-receptor pairs."""
+    z_np = _to_numpy(z)
+    if z_np.ndim == 4:
+        if z_np.shape[0] != 1:
+            raise ValueError(f"Expected one affinity sample, got z={z_np.shape}")
+        z_np = z_np[0]
+    if z_np.ndim != 3:
+        raise ValueError(f"Expected z [L,L,C], got {z_np.shape}")
+
+    def one(x: torch.Tensor) -> np.ndarray:
+        value = _to_numpy(x)
+        return value[0] if value.ndim > 0 and value.shape[0] == 1 else value
+
+    pad_raw = one(token_pad_mask)
+    pad = pad_raw.astype(bool)
+    lig = one(affinity_token_mask).astype(bool) & pad
+    lig_idx = np.flatnonzero(lig[: z_np.shape[0]]).astype(np.int64)
+    if lig_idx.size == 0:
+        raise ValueError("Affinity cache has no binder/ligand tokens")
+
+    L = z_np.shape[0]
+    token_to_rep = one(token_to_rep_atom)
+    if token_to_rep.shape[0] != L:
+        raise ValueError(
+            f"token_to_rep_atom token count {token_to_rep.shape[0]} != L={L}"
+        )
+    rep_atom_indices = token_to_rep.argmax(axis=1).astype(np.int64)
+    if not np.allclose(token_to_rep[np.arange(L), rep_atom_indices], 1.0):
+        raise ValueError("token_to_rep_atom is not a one-hot representative-atom map")
+    arrays = {
+        "format": np.array(AFFINITY_CROPPED_FORMAT),
+        "z_rows": np.ascontiguousarray(z_np[lig_idx], dtype=np.float32),
+        "z_cols": np.ascontiguousarray(z_np[:, lig_idx], dtype=np.float32),
+        "lig_idx": lig_idx,
+        "L": np.array(L, dtype=np.int64),
+        "s_inputs": np.ascontiguousarray(one(s_inputs), dtype=np.float32),
+        "coords": np.ascontiguousarray(_to_numpy(coords), dtype=np.float32),
+        "rep_atom_indices": rep_atom_indices,
+        "token_pad_mask": pad_raw[:L].astype(np.float32),
+        "mol_type": one(mol_type)[:L].astype(np.int64),
+        "affinity_token_mask": one(affinity_token_mask)[:L].astype(bool),
+        "affinity_token_indices": np.arange(L, dtype=np.int64),
+    }
+    if original_token_indices is not None:
+        arrays["original_token_indices"] = one(original_token_indices)[:L].astype(
+            np.int64
+        )
+    if affinity_mw is not None:
+        arrays["affinity_mw"] = _to_numpy(affinity_mw).astype(np.float32)
+
+    Path(path).parent.mkdir(parents=True, exist_ok=True)
+    np.savez(path, **arrays)
+
+
+def load_affinity_cropped_inputs(path: Union[str, Path]) -> dict[str, torch.Tensor]:
+    """Load and validate a self-contained ``affinity_cropped_v1`` cache."""
+    path = Path(path)
+    with np.load(path, allow_pickle=False) as npz:
+        fmt = str(npz["format"].item()) if "format" in npz.files else ""
+        if fmt != AFFINITY_CROPPED_FORMAT:
+            raise ValueError(
+                f"Expected format={AFFINITY_CROPPED_FORMAT}, got {fmt!r}: {path}"
+            )
+        full_z = reconstruct_z_from_cropped(npz)
+        L = int(npz["L"])
+        own_map = npz["affinity_token_indices"].astype(np.int64)
+        if not np.array_equal(own_map, np.arange(L, dtype=np.int64)):
+            raise ValueError(f"Invalid affinity token index map in {path}")
+        arrays = {key: np.array(npz[key]) for key in npz.files}
+
+    rep_atom_indices = arrays["rep_atom_indices"].astype(np.int64)
+    atom_count = arrays["coords"].shape[-2]
+    token_to_rep_atom = np.zeros((L, atom_count), dtype=np.float32)
+    token_to_rep_atom[np.arange(L), rep_atom_indices] = 1.0
+    out = {
+        "z": torch.from_numpy(full_z).unsqueeze(0),
+        "s_inputs": torch.from_numpy(arrays["s_inputs"]).unsqueeze(0),
+        "coords": torch.from_numpy(arrays["coords"]),
+        "token_to_rep_atom": torch.from_numpy(token_to_rep_atom).unsqueeze(0),
+        "token_pad_mask": torch.from_numpy(arrays["token_pad_mask"]).unsqueeze(0),
+        "mol_type": torch.from_numpy(arrays["mol_type"]).unsqueeze(0),
+        "affinity_token_mask": torch.from_numpy(
+            arrays["affinity_token_mask"]
+        ).unsqueeze(0),
+    }
+    if "affinity_mw" in arrays:
+        out["affinity_mw"] = torch.from_numpy(arrays["affinity_mw"])
+    return out
